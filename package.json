{
  "name": "abstract-hub",
  "productName": "Abstract Hub",
  "version": "0.1.30",
  "description": "Desktop automation hub for the Abstract ecosystem",
  "author": "Abstract Hub",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "play": "tsx internal/src/play.ts",
    "unlock": "tsx internal/src/unlock.ts",
    "ui": "node scripts/build-browser-auth.mjs && tsx internal/src/ui/server.ts",
    "inventory": "tsx internal/src/inventory.ts",
    "skills": "tsx internal/src/skills/cli.ts",
    "sell-all": "tsx internal/src/sell-all.ts",
    "doctor": "tsx internal/src/doctor.ts",
    "start": "tsx internal/src/cli.ts",
    "start:all": "tsx internal/src/cli.ts --all",
    "build": "tsc -p internal/tsconfig.json && tsc -p browser-src/tsconfig.json && node scripts/build-browser-auth.mjs && node scripts/copy-runtime-assets.mjs",
    "desktop": "pnpm build && electron desktop/main.cjs",
    "dist:mac": "pnpm build && node scripts/prepare-keytar-universal.mjs && electron-builder --mac --universal --config.npmRebuild=false --publish never && node scripts/prune-release.mjs",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never && node scripts/prune-release.mjs",
    "release:prune": "node scripts/prune-release.mjs",
    "test": "vitest run --config internal/vitest.config.ts",
    "test:watch": "vitest --config internal/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config internal/vitest.config.ts",
    "lint": "eslint -c internal/eslint.config.js . && prettier --check .",
    "lint:fix": "eslint -c internal/eslint.config.js . --fix && prettier --write .",
    "vault": "tsx internal/src/vault/cli.ts",
    "wallet": "tsx internal/src/wallet/cli.ts",
    "typecheck": "tsc --noEmit -p internal/tsconfig.json && tsc -p browser-src/tsconfig.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,yaml,yml,md}": "prettier --write",
    "*.{ts,js}": "eslint --fix"
  },
  "dependencies": {
    "@abstract-foundation/agw-cli": "0.1.8",
    "@abstract-foundation/agw-client": "^1.12.3",
    "@abstract-foundation/agw-web": "1.10.4",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@privy-io/cross-app-connect": "^0.5.15",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "express": "^5.2.1",
    "inquirer": "^13.4.3",
    "keytar": "^7.9.0",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.3.0",
    "viem": "^2.49.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "41.10.2",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "nock": "^14.0.15",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
